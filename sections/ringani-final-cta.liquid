{%- comment -%}
  RINGANI – Final CTA
  Self-contained full-bleed image with overlaid heading, text and a button.
  Deliberately does NOT use the ringani-image snippet: the image is rendered
  here as a <picture> so the <img> can fill the whole section via
  width:100%; height:100%; object-fit:cover.
{%- endcomment -%}
{%- liquid
  assign alt_text = section.settings.heading | default: 'RINGANI' | strip_html | escape
  assign mob = section.settings.image_mobile | default: section.settings.image
-%}
<section
  class="ringani ringani-final"
  data-ringani-final
  style="--ringani-final-h:{{ section.settings.height }}px;--ringani-final-h-m:{{ section.settings.height_mobile }}px;--ringani-final-ov:{{ section.settings.overlay_opacity | divided_by: 100.0 }};--ringani-final-pos:{{ section.settings.object_position }}"
>
  <div class="ringani-final__media">
    {%- if section.settings.image != blank -%}
      <picture>
        {%- if mob != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ mob | image_url: width: 800 }} 800w, {{ mob | image_url: width: 1200 }} 1200w, {{ mob | image_url: width: 1600 }} 1600w"
            sizes="100vw">
        {%- endif -%}
        <img
          class="ringani-final__img"
          src="{{ section.settings.image | image_url: width: 1600 }}"
          srcset="{{ section.settings.image | image_url: width: 720 }} 720w, {{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1600 }} 1600w, {{ section.settings.image | image_url: width: 2000 }} 2000w"
          sizes="100vw"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          alt="{{ alt_text }}"
          loading="lazy"
          decoding="async">
      </picture>
    {%- else -%}
      <div class="ringani-final__placeholder">{{ 'lifestyle-2' | placeholder_svg_tag: 'ringani-final__img' }}</div>
    {%- endif -%}
  </div>
  <div class="ringani-final__scrim" aria-hidden="true"></div>
  <div class="ringani-final__content">
    <div class="ringani-reveal ringani-final__inner">
      {%- if section.settings.heading != blank -%}<h2 class="ringani-final__h">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<p class="ringani-final__body">{{ section.settings.body }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#ringani-produkt' }}" class="ringani-btn ringani-btn--light ringani-final__btn">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.ringani-final{position:relative;width:100%;min-height:var(--ringani-final-h,700px);display:flex;align-items:flex-end;background:linear-gradient(180deg,#061726,#0B2A4E);overflow:hidden}
.ringani-final__media{position:absolute;inset:0;z-index:0}
.ringani-final__media picture{display:block;width:100%;height:100%}
.ringani-final__img{display:block;width:100%;height:100%;object-fit:cover;object-position:var(--ringani-final-pos,center)}
.ringani-final__placeholder{width:100%;height:100%}
.ringani-final__placeholder svg{width:100%;height:100%;object-fit:cover}
.ringani-final__scrim{position:absolute;inset:0;z-index:1;pointer-events:none;opacity:var(--ringani-final-ov,.55);background:linear-gradient(180deg,rgba(5,18,34,.15) 0%,rgba(5,20,38,1) 82%)}
.ringani-final__content{position:relative;z-index:2;padding:clamp(32px,6vw,96px);max-width:52ch}
.ringani-final__inner{color:#F5F3EF}
.ringani-final__h{font-size:clamp(30px,5vw,60px);line-height:1.04;letter-spacing:-.035em;font-weight:400}
.ringani-final__body{font-size:clamp(15px,1.4vw,18px);line-height:1.7;color:#D8D4CC;margin-top:18px}
.ringani-final__btn{margin-top:32px;height:56px;padding:0 38px;font-size:11.5px;letter-spacing:.2em}
@media (max-width:749px){
  .ringani-final{min-height:var(--ringani-final-h-m,var(--ringani-final-h,540px))}
  .ringani-final__h{font-size:clamp(26px,7vw,36px)}
  .ringani-final__content{padding:clamp(20px,5vw,40px)}
  .ringani-final__btn{min-height:44px;padding:0 28px}
}
{% endstylesheet %}

{% schema %}
{
  "name": "RINGANI – Final CTA",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image", "label": "Image (Desktop)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image (Mobile, optional)" },
    { "type": "select", "id": "object_position", "label": "Image focus", "info": "Which area of the image stays visible when the image fills the section.", "options": [
      { "value": "center", "label": "Center" },
      { "value": "top", "label": "Top" },
      { "value": "bottom", "label": "Bottom" },
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" },
      { "value": "left top", "label": "Top left" },
      { "value": "right top", "label": "Top right" },
      { "value": "left bottom", "label": "Bottom left" },
      { "value": "right bottom", "label": "Bottom right" }
    ], "default": "center" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Overlay darkness", "info": "Dark gradient over the image – ensures readable text.", "default": 55 },
    { "type": "header", "content": "Height" },
    { "type": "range", "id": "height", "min": 360, "max": 960, "step": 10, "unit": "px", "label": "Min height (Desktop)", "default": 700 },
    { "type": "range", "id": "height_mobile", "min": 300, "max": 800, "step": 10, "unit": "px", "label": "Min height (Mobile)", "default": 540 },
    { "type": "header", "content": "Content" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Get to know your body better." },
    { "type": "textarea", "id": "body", "label": "Text", "default": "With RINGANI, daily data becomes a clearer picture of your health and habits." },
    { "type": "text", "id": "button_label", "label": "Button text", "default": "Discover RINGANI" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Default: scrolls to the product section (#ringani-produkt)." }
  ],
  "presets": [
    { "name": "RINGANI – Final CTA" }
  ]
}
{% endschema %}
