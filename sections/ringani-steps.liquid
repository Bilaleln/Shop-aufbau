{%- comment -%}
  RINGANI – How It Works
  Dark section: heading + numbered steps (image + title + body) as blocks.
{%- endcomment -%}
<section id="{{ section.settings.anchor | default: 'how-it-works' }}" class="ringani ringani-section ringani-on-dark ringani-steps" style="{% render 'ringani-section-vars', s: section %}">
  <div class="ringani-inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="ringani-h2 ringani-reveal ringani-steps__h">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="ringani-reveal ringani-steps__grid">
      {%- for block in section.blocks -%}
        <div class="ringani-steps__item" {{ block.shopify_attributes }}>
          <div class="ringani-steps__num">{{ block.settings.num | default: forloop.index | prepend: '0' }}</div>
          <div class="ringani-media ringani-media--dark ringani-steps__media">
            {%- render 'ringani-image', image: block.settings.image, alt: block.settings.title, sizes: '(min-width: 750px) 30vw, 100vw', placeholder: 'product-2' -%}
          </div>
          <h3 class="ringani-steps__title">{{ block.settings.title }}</h3>
          {%- if block.settings.body != blank -%}<p class="ringani-steps__body">{{ block.settings.body }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.ringani-steps{background:linear-gradient(200deg,#050F1C 0%,#0C2C50 100%)}
.ringani-steps__h{font-weight:400;max-width:20ch}
.ringani-steps__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:clamp(20px,3vw,44px);margin-top:clamp(40px,5vw,72px)}
.ringani-steps__item{border-top:1px solid #2C2C29;padding-top:24px}
.ringani-steps__num{font-family:var(--ringani-mono);font-size:11px;letter-spacing:.2em;color:#8F8A80}
.ringani-steps__media{width:100%;aspect-ratio:5/4;border-radius:6px;margin-top:22px}
.ringani-steps__title{font-size:22px;letter-spacing:-.02em;font-weight:500;margin-top:22px}
.ringani-steps__body{font-size:15px;line-height:1.65;color:#A5A099;margin-top:10px}
@media (max-width:749px){
  .ringani-steps__grid{grid-template-columns:1fr;gap:32px}
  .ringani-steps__media{aspect-ratio:4/3}
  .ringani-steps__h{font-size:clamp(24px,6.5vw,32px)}
}
{% endstylesheet %}

{% schema %}
{
  "name": "RINGANI – How It Works",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "How RINGANI works. It's that simple." },
    { "type": "text", "id": "anchor", "label": "Anchor ID (for navigation)", "default": "how-it-works" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Top (Desktop)", "default": 120 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Bottom (Desktop)", "default": 120 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top (Mobile)", "default": 72 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom (Mobile)", "default": 72 }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "num", "label": "Number", "default": "01" },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "title", "label": "Title", "default": "Wear the ring" },
      { "type": "textarea", "id": "body", "label": "Text", "default": "Wear your RINGANI Smart Ring comfortably throughout your day – day and night." }
    ] }
  ],
  "presets": [
    { "name": "RINGANI – How It Works", "blocks": [
      { "type": "step", "settings": { "num": "01", "title": "Wear the ring", "body": "Wear your RINGANI Smart Ring comfortably throughout your day – day and night." } },
      { "type": "step", "settings": { "num": "02", "title": "Collect data", "body": "The integrated sensors automatically capture supported metrics in the background." } },
      { "type": "step", "settings": { "num": "03", "title": "Understand insights", "body": "Open the app and discover your personal trends – clearly presented instead of raw numbers." } }
    ] }
  ]
}
{% endschema %}
