{%- comment -%}
  RINGANI – Everyday / Water resistance
  Intro copy + a grid of labelled lifestyle tiles.
{%- endcomment -%}
<section class="ringani ringani-section ringani-everyday" style="{% render 'ringani-section-vars', s: section %}">
  <div class="ringani-inner">
    <div class="ringani-reveal ringani-everyday__intro">
      {%- if section.settings.heading != blank -%}<h2 class="ringani-h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<p class="ringani-lead ringani-everyday__body">{{ section.settings.body }}</p>{%- endif -%}
    </div>
    <div class="ringani-reveal ringani-everyday__grid">
      {%- for block in section.blocks -%}
        <div class="ringani-media ringani-everyday__tile" {{ block.shopify_attributes }}>
          {%- render 'ringani-image', image: block.settings.image, alt: block.settings.label, sizes: '(min-width: 750px) 22vw, 45vw', placeholder: 'lifestyle-1' -%}
          {%- if block.settings.label != blank -%}<div class="ringani-everyday__label">{{ block.settings.label }}</div>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.ringani-everyday__intro{max-width:46ch}
.ringani-everyday__body{margin-top:18px}
.ringani-everyday__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-top:clamp(32px,4vw,56px)}
.ringani-everyday__tile{position:relative;aspect-ratio:3/4;border-radius:6px}
.ringani-everyday__label{position:absolute;left:0;right:0;top:0;padding:16px;pointer-events:none;font-family:var(--ringani-mono);font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:#FFFFFF;text-shadow:0 1px 6px rgba(0,0,0,.5)}
@media (max-width:749px){
  .ringani-everyday__grid{grid-template-columns:repeat(2,1fr);gap:10px}
  .ringani-everyday__tile{aspect-ratio:4/5}
  .ringani-everyday__intro{max-width:none}
}
{% endstylesheet %}

{% schema %}
{
  "name": "RINGANI – Everyday",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Ready for your everyday." },
    { "type": "textarea", "id": "body", "label": "Text", "default": "Water resistance: 10 ATM. From workouts to the shower to the night – RINGANI stays on your finger." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Top (Desktop)", "default": 120 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Bottom (Desktop)", "default": 120 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top (Mobile)", "default": 72 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom (Mobile)", "default": 72 }
  ],
  "blocks": [
    { "type": "tile", "name": "Tile", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "label", "label": "Label", "default": "Workout" }
    ] }
  ],
  "presets": [
    { "name": "RINGANI – Everyday", "blocks": [
      { "type": "tile", "settings": { "label": "Workout" } },
      { "type": "tile", "settings": { "label": "Shower" } },
      { "type": "tile", "settings": { "label": "Everyday" } },
      { "type": "tile", "settings": { "label": "Night" } }
    ] }
  ]
}
{% endschema %}
