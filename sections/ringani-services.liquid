{%- comment -%}
  RINGANI – Service Promises
  Grid of trust/service items (title + text) as reorderable blocks.
{%- endcomment -%}
<section class="ringani ringani-section ringani-services" style="{% render 'ringani-section-vars', s: section %}">
  <div class="ringani-inner ringani-reveal ringani-services__grid">
    {%- for block in section.blocks -%}
      <div class="ringani-services__item" {{ block.shopify_attributes }}>
        <h3 class="ringani-services__title">{{ block.settings.title }}</h3>
        {%- if block.settings.body != blank -%}<p class="ringani-services__body">{{ block.settings.body }}</p>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
.ringani-services__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:clamp(20px,3vw,40px)}
.ringani-services__item{border-top:1px solid #DEDBD4;padding-top:22px}
.ringani-services__title{font-size:17px;font-weight:500;letter-spacing:-.01em}
.ringani-services__body{font-size:14.5px;line-height:1.65;color:#5F5C55;margin-top:10px}
@media (max-width:749px){
  .ringani-services__grid{grid-template-columns:repeat(2,1fr);gap:16px}
  .ringani-services__title{font-size:15.5px}
  .ringani-services__body{font-size:13.5px}
}
{% endstylesheet %}

{% schema %}
{
  "name": "RINGANI – Service Promises",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Top (Desktop)", "default": 120 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Bottom (Desktop)", "default": 120 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top (Mobile)", "default": 72 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom (Mobile)", "default": 72 }
  ],
  "blocks": [
    { "type": "service", "name": "Promise", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Free Shipping" },
      { "type": "textarea", "id": "body", "label": "Text", "default": "Free shipping within the US, delivery typically in 3–5 business days." }
    ] }
  ],
  "presets": [
    { "name": "RINGANI – Service Promises", "blocks": [
      { "type": "service", "settings": { "title": "Free Shipping", "body": "Free shipping within the US, delivery typically in 3–5 business days." } },
      { "type": "service", "settings": { "title": "30-Day Returns", "body": "Not convinced? Return hassle-free within 30 days." } },
      { "type": "service", "settings": { "title": "2-Year Warranty", "body": "Warranty on material and manufacturing defects." } },
      { "type": "service", "settings": { "title": "Customer Support", "body": "Personal support via email – response typically within one business day." } }
    ] }
  ]
}
{% endschema %}
