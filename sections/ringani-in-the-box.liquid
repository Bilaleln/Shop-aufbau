{%- comment -%}
  RINGANI – What's in the Box
  Image + list of included items (reorderable blocks with name + note).
{%- endcomment -%}
<section class="ringani ringani-section ringani-box" style="{% render 'ringani-section-vars', s: section %}">
  <div class="ringani-inner ringani-box__grid">
    <div class="ringani-reveal ringani-media ringani-box__media" style="order:{% if section.settings.image_position == 'right' %}2{% else %}1{% endif %}">
      {%- render 'ringani-image', image: section.settings.image, image_mobile: section.settings.image_mobile, alt: section.settings.heading, sizes: '(min-width: 750px) 50vw, 100vw', placeholder: 'product-1' -%}
    </div>
    <div class="ringani-reveal ringani-box__text" style="order:{% if section.settings.image_position == 'right' %}1{% else %}2{% endif %}">
      {%- if section.settings.eyebrow != blank -%}<div class="ringani-eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="ringani-box__h">{{ section.settings.heading }}</h2>{%- endif -%}
      <div class="ringani-box__list">
        {%- for block in section.blocks -%}
          <div class="ringani-box__item" {{ block.shopify_attributes }}>
            <span class="ringani-box__name">{{ block.settings.name }}</span>
            <span class="ringani-box__note">{{ block.settings.note }}</span>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.ringani-box__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:clamp(32px,5vw,72px);align-items:center}
.ringani-box__media{width:100%;aspect-ratio:4/3;border-radius:6px}
.ringani-box__h{font-size:clamp(30px,4.2vw,50px);line-height:1.05;letter-spacing:-.03em;font-weight:500;margin-top:18px}
.ringani-box__list{margin-top:26px;border-top:1px solid #E8E5DF}
.ringani-box__item{display:flex;justify-content:space-between;gap:16px;padding:16px 0;border-bottom:1px solid #E8E5DF}
.ringani-box__name{font-size:15.5px;color:#0E0E0E}
.ringani-box__note{font-size:13.5px;color:#8A867E;text-align:right}
@media (max-width:749px){
  .ringani-box__grid{grid-template-columns:1fr;gap:24px}
  .ringani-box__media{order:-1 !important;aspect-ratio:4/3}
  .ringani-box__text{order:2 !important}
  .ringani-box__h{font-size:clamp(26px,7vw,34px)}
}
{% endstylesheet %}

{% schema %}
{
  "name": "RINGANI – What's in the Box",
  "tag": "section",
  "max_blocks": 10,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What's Included" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Everything you need." },
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image", "label": "Image (Desktop)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image (Mobile, optional)" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Top (Desktop)", "default": 120 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Bottom (Desktop)", "default": 120 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top (Mobile)", "default": 72 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom (Mobile)", "default": 72 }
  ],
  "blocks": [
    { "type": "item", "name": "Item", "settings": [
      { "type": "text", "id": "name", "label": "Name", "default": "RINGANI Smart Ring" },
      { "type": "text", "id": "note", "label": "Note", "default": "in your chosen color & size" }
    ] }
  ],
  "presets": [
    { "name": "RINGANI – What's in the Box", "blocks": [
      { "type": "item", "settings": { "name": "RINGANI Smart Ring", "note": "in your chosen color & size" } },
      { "type": "item", "settings": { "name": "Charging Case", "note": "with integrated battery" } },
      { "type": "item", "settings": { "name": "USB-C charging cable", "note": "" } },
      { "type": "item", "settings": { "name": "Quick Start Guide", "note": "" } }
    ] }
  ]
}
{% endschema %}
