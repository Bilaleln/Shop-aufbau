{%- comment -%}
  RINGANI – Feature Rows
  Alternating image + text storytelling rows (Sleep / Recovery / Activity).
  Each row is a reorderable block.
{%- endcomment -%}
<section id="{{ section.settings.anchor | default: 'technologie' }}" class="ringani ringani-section ringani-features" style="{% render 'ringani-section-vars', s: section %}">
  <div class="ringani-inner ringani-features__wrap">
    {%- for block in section.blocks -%}
      {%- liquid
        assign pos = block.settings.image_position
        if pos == 'auto'
          assign idx = forloop.index0 | modulo: 2
          if idx == 0
            assign pos = 'left'
          else
            assign pos = 'right'
          endif
        endif
        assign points = block.settings.points | newline_to_br | strip_newlines | split: '<br />'
      -%}
      <div class="ringani-reveal ringani-features__row" {{ block.shopify_attributes }}>
        <div class="ringani-media ringani-features__media" style="order:{% if pos == 'left' %}1{% else %}2{% endif %}">
          {%- render 'ringani-image', image: block.settings.image, image_mobile: block.settings.image_mobile, alt: block.settings.title, sizes: '(min-width: 750px) 50vw, 100vw', placeholder: 'lifestyle-1' -%}
        </div>
        <div class="ringani-features__text" style="order:{% if pos == 'left' %}2{% else %}1{% endif %}">
          {%- if block.settings.label != blank -%}<div class="ringani-eyebrow">{{ block.settings.label }}</div>{%- endif -%}
          <h2 class="ringani-features__h">{{ block.settings.title }}</h2>
          {%- if block.settings.body != blank -%}<p class="ringani-lead ringani-features__body">{{ block.settings.body }}</p>{%- endif -%}
          {%- if points.size > 0 and block.settings.points != blank -%}
            <div class="ringani-features__points">
              {%- for p in points -%}<div class="ringani-features__point"><span>—</span><span>{{ p | strip }}</span></div>{%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
.ringani-features__wrap{max-width:1280px;margin:0 auto;display:grid;gap:clamp(64px,8vw,132px)}
.ringani-features__row{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:clamp(28px,4vw,72px);align-items:center}
.ringani-features__media{width:100%;aspect-ratio:4/3;border-radius:6px}
.ringani-features__text{max-width:44ch}
.ringani-features__h{font-size:clamp(28px,3.8vw,46px);line-height:1.06;letter-spacing:-.03em;font-weight:500;margin-top:18px}
.ringani-features__body{margin-top:16px}
.ringani-features__points{margin-top:22px;display:grid;gap:9px}
.ringani-features__point{display:flex;gap:11px;font-size:14px;color:#3A3833;line-height:1.5}
.ringani-features__point span:first-child{color:#1B6FD4}
@media (max-width:749px){
  .ringani-features__row{grid-template-columns:1fr;gap:20px}
  .ringani-features__media{order:-1 !important;aspect-ratio:4/3}
  .ringani-features__text{order:2 !important;max-width:none}
  .ringani-features__h{font-size:clamp(24px,6.5vw,32px)}
}
{% endstylesheet %}

{% schema %}
{
  "name": "RINGANI – Feature Rows",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID (for navigation)", "default": "technologie" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Top (Desktop)", "default": 120 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Bottom (Desktop)", "default": 120 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top (Mobile)", "default": 72 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom (Mobile)", "default": 72 }
  ],
  "blocks": [
    { "type": "feature", "name": "Feature", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Sleep" },
      { "type": "text", "id": "title", "label": "Title", "default": "Understand your sleep." },
      { "type": "textarea", "id": "body", "label": "Text", "default": "RINGANI captures your night without a display and without disturbance. In the morning, you see sleep duration, sleep stages, and resting heart rate in one clear picture." },
      { "type": "textarea", "id": "points", "label": "Points (one per line)", "default": "Sleep duration and sleep stages\nResting heart rate overnight\nPersonal weekly and monthly trends" },
      { "type": "image_picker", "id": "image", "label": "Image (Desktop)" },
      { "type": "image_picker", "id": "image_mobile", "label": "Image (Mobile, optional)" },
      { "type": "select", "id": "image_position", "label": "Image position", "options": [ { "value": "auto", "label": "Auto alternating" }, { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "auto" }
    ] }
  ],
  "presets": [
    { "name": "RINGANI – Feature Rows", "blocks": [
      { "type": "feature", "settings": { "label": "Sleep", "title": "Understand your sleep.", "body": "RINGANI captures your night without a display and without disturbance. In the morning, you see sleep duration, sleep stages, and resting heart rate in one clear picture – and discover what truly influences your nights.", "points": "Sleep duration and sleep stages\nResting heart rate overnight\nPersonal weekly and monthly trends", "image_position": "auto" } },
      { "type": "feature", "settings": { "label": "Recovery", "title": "Know when your body is ready.", "body": "Your nightly data creates a daily recovery score. It helps you decide whether today is a day for intensity or rest – without having to work through raw data.", "points": "Daily recovery score\nComparison with your personal baseline\nGuidance on exertion and rest", "image_position": "auto" } },
      { "type": "feature", "settings": { "label": "Activity", "title": "Movement that becomes visible.", "body": "Steps, active minutes, and daily movement are automatically tracked – without having to start an activity. Over weeks, an honest picture of your habits emerges.", "points": "Automatic activity tracking\nSteps and active minutes\nLong-term trend analysis", "image_position": "auto" } }
    ] }
  ]
}
{% endschema %}
