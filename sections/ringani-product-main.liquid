{%- comment -%}
  RINGANI – Product (Main)
  The commerce core. Uses real Shopify product / variant data:
  media gallery, price, compare-at, colour swatches + size picker generated
  from the product's own options, a native cart form, a synchronised sticky
  add-to-cart bar and a size-guide modal.

  Colour + size selectors are mapped to the product's options by NAME
  (section settings), so no variant is hard-coded.
{%- endcomment -%}

{{ 'ringani.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ringani-product.js' | asset_url }}" defer="defer"></script>
{%- comment -%}
  Bridge: expose the theme's standard cart events module (Horizon and other
  themes that ship it via an import map) so the add-to-cart can trigger the
  theme's own cart drawer / header sync. Fails silently on themes without it,
  in which case ringani-product.js uses its generic cart path.
{%- endcomment -%}
<script type="module">
  try {
    const m = await import('@shopify/events');
    window.__ringaniEvents = m;
  } catch (e) { /* theme has no standard events module — generic cart path used */ }
</script>

{%- liquid
  assign color_name = section.settings.color_option_name | downcase | strip
  assign size_name  = section.settings.size_option_name  | downcase | strip
  assign color_pos = 0
  assign size_pos = 0
  for opt in product.options_with_values
    assign on = opt.name | downcase | strip
    if on == color_name
      assign color_pos = opt.position
    endif
    if on == size_name
      assign size_pos = opt.position
    endif
  endfor

  assign color_idx = color_pos | minus: 1
  assign size_idx = size_pos | minus: 1
  assign current = product.selected_or_first_available_variant
  assign featured_id = current.featured_media.id
  assign has_compare = false
  if current.compare_at_price and current.compare_at_price > current.price
    assign has_compare = true
  endif
  assign savings_amount = current.compare_at_price | minus: current.price | at_least: 0 | money
  assign save_text = section.settings.save_template | replace: '{amount}', savings_amount
-%}

<section
  class="ringani ringani-section ringani-pm"
  id="ringani-produkt"
  style="--ringani-pt:{{ section.settings.padding_top }}px;--ringani-pb:{{ section.settings.padding_bottom }}px;--ringani-pt-m:{{ section.settings.padding_top_mobile }}px;--ringani-pb-m:{{ section.settings.padding_bottom_mobile }}px;">
  <ringani-product
    class="ringani-inner ringani-pm__grid"
    data-section-id="{{ section.id }}"
    data-color-position="{{ color_pos }}"
    data-size-position="{{ size_pos }}"
    data-option-count="{{ product.options.size }}"
    data-cart-add-url="{{ routes.cart_add_url }}"
    data-cart-url="{{ routes.cart_url }}"
    data-product-url="{{ product.url }}"
    data-on-add="{{ section.settings.on_add }}"
    data-label-add="{{ section.settings.label_add | escape }}"
    data-label-soldout="{{ section.settings.label_soldout | escape }}"
    data-label-choose="{{ section.settings.label_choose | escape }}"
    data-save-template="{{ section.settings.save_template | escape }}"
    data-money-format="{{ shop.money_format | strip_html | escape }}"
    data-scroll-anchor="ringani-produkt"
    data-added-msg="{{ 'Added to cart' }}">

    {%- comment -%} ---------- Variant data for the controller ---------- {%- endcomment -%}
    <script type="application/json" data-ringani-variants>
      [
        {%- for v in product.variants -%}
          {
            "id": {{ v.id }},
            "available": {{ v.available }},
            "options": {{ v.options | json }},
            "price": {{ v.price | money | json }},
            "price_raw": {{ v.price }},
            "compare_at_price": {{ v.compare_at_price | money | json }},
            "compare_at_price_raw": {{ v.compare_at_price | default: 0 }},
            "savings": {{ v.compare_at_price | minus: v.price | at_least: 0 | money | json }},
            "featured_media_id": {% if v.featured_media %}{{ v.featured_media.id }}{% else %}null{% endif %},
            "plans": {
              {%- for a in v.selling_plan_allocations -%}
                "{{ a.selling_plan.id }}": { "price_raw": {{ a.price }}, "compare_raw": {{ a.compare_at_price | default: v.price }} }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            }
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    </script>

    {%- comment -%} ================= GALLERY ================= {%- endcomment -%}
    <div class="ringani-pm__gallery-col">
      <div class="ringani-pm__stage ringani-media" data-ringani-gallery>
        {%- if product.media.size > 0 -%}
          {%- for media in product.media -%}
            {%- assign is_active = false -%}
            {%- if featured_id and media.id == featured_id -%}{%- assign is_active = true -%}
            {%- elsif featured_id == blank and forloop.first -%}{%- assign is_active = true -%}{%- endif -%}
            <div class="ringani-pm__slide" data-media-id="{{ media.id }}" style="opacity:{% if is_active %}1{% else %}0{% endif %};pointer-events:{% if is_active %}auto{% else %}none{% endif %}">
              {%- render 'ringani-media', media: media, loading: forloop.first, sizes: '(min-width: 750px) 46vw, 100vw' -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="ringani-pm__slide" data-media-id="0" style="opacity:1">
            {{ 'product-1' | placeholder_svg_tag: 'ringani-media__placeholder' }}
          </div>
        {%- endif -%}
      </div>

      {%- if product.media.size > 1 -%}
        <div class="ringani-pm__thumbs">
          {%- for media in product.media -%}
            {%- assign thumb_alt = media.alt | default: product.title | escape -%}
            <button type="button" class="ringani-pm__thumb" data-ringani-thumb data-media-id="{{ media.id }}"
              aria-current="{% if featured_id and media.id == featured_id %}true{% elsif featured_id == blank and forloop.first %}true{% else %}false{% endif %}"
              aria-label="{{ thumb_alt }}">
              {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '96, 192', alt: thumb_alt }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ================= INFO / PURCHASE ================= {%- endcomment -%}
    <div class="ringani-pm__info">

      {%- if section.settings.rating_show -%}
        <div class="ringani-pm__rating">
          <span class="ringani-pm__stars" aria-hidden="true">★★★★★</span>
          <span>{{ section.settings.rating_text }}</span>
        </div>
      {%- endif -%}

      <h1 class="ringani-pm__title">{{ product.title | escape }}</h1>

      {%- if section.settings.subheading != blank -%}
        <p class="ringani-pm__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}

      <div class="ringani-pm__price-row">
        <span class="ringani-pm__price" data-ringani-price>{{ current.price | money }}</span>
        <span class="ringani-pm__compare" data-ringani-compare {% unless has_compare %}hidden{% endunless %}>{{ current.compare_at_price | money }}</span>
        {%- if section.settings.show_savings -%}
          <span class="ringani-pm__save" data-ringani-save {% unless has_compare %}hidden{% endunless %}>{{ save_text }}</span>
        {%- endif -%}
      </div>
      {%- if section.settings.tax_note != blank -%}
        <p class="ringani-pm__tax">{{ section.settings.tax_note }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        {%- assign benefit_blocks = section.blocks | where: 'type', 'benefit' -%}
        {%- if benefit_blocks.size > 0 -%}
          <ul class="ringani-pm__benefits">
            {%- for block in benefit_blocks -%}
              <li {{ block.shopify_attributes }}>
                <span class="ringani-pm__check">✓</span>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      {%- endif -%}

      {%- comment -%} ---------- Colour swatches ---------- {%- endcomment -%}
      {%- if color_pos > 0 -%}
        {%- assign color_option = product.options_with_values[color_idx] -%}
        {%- assign current_color = current.options[color_idx] -%}
        <div class="ringani-pm__group">
          <div class="ringani-pm__group-head">
            <span class="ringani-eyebrow">{{ color_option.name }}</span>
            <span class="ringani-pm__group-val" data-ringani-color-name>{{ current_color }}</span>
          </div>
          <div class="ringani-pm__swatches">
            {%- for value in color_option.values -%}
              {%- liquid
                assign vname = value.name | default: value
                assign swatch_bg = ''
                assign swatch_img = ''
                if value.swatch.image
                  assign swatch_img = value.swatch.image | image_url: width: 100
                elsif value.swatch.color
                  assign swatch_bg = value.swatch.color
                endif
                assign key = vname | downcase | strip
                if swatch_bg == '' and swatch_img == blank
                  case key
                    when 'schwarz','black','anthrazit','graphit'
                      assign swatch_bg = 'linear-gradient(145deg,#3A3A38,#131312)'
                    when 'silber','silver','grau','gray','platin'
                      assign swatch_bg = 'linear-gradient(145deg,#EDEDEA,#B7B7B1)'
                    when 'gold','roségold','rosegold','rose gold'
                      assign swatch_bg = 'linear-gradient(145deg,#E3CBA1,#B4915F)'
                    when 'blau','blue','navy'
                      assign swatch_bg = 'linear-gradient(145deg,#3E6FA8,#183A63)'
                    else
                      assign swatch_bg = '#C7C4BD'
                  endcase
                endif
              -%}
              <button type="button" class="ringani-pm__swatch" data-ringani-swatch data-value="{{ vname | escape }}"
                aria-pressed="{% if current_color == vname %}true{% else %}false{% endif %}"
                aria-label="{{ color_option.name }}: {{ vname | escape }}">
                <span class="ringani-pm__swatch-dot" style="background:{% if swatch_img %}center/cover url({{ swatch_img }}){% else %}{{ swatch_bg }}{% endif %}"></span>
              </button>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} ---------- Size picker (dark panel) ---------- {%- endcomment -%}
      {%- if size_pos > 0 -%}
        {%- assign size_option = product.options_with_values[size_idx] -%}
        <div class="ringani-pm__sizepanel">
          <div class="ringani-pm__sizepanel-head">
            <div>
              <div class="ringani-pm__sizepanel-title">{{ section.settings.size_panel_heading }}</div>
              <div class="ringani-pm__sizepanel-sub">{{ section.settings.size_panel_sub }}</div>
            </div>
            <span class="ringani-pm__sizebadge" data-ringani-size-badge data-active="false" aria-hidden="true">✓</span>
          </div>
          <div class="ringani-pm__sizes">
            {%- for value in size_option.values -%}
              {%- assign vname = value.name | default: value -%}
              <button type="button" class="ringani-pm__size" data-ringani-size data-value="{{ vname | escape }}"
                aria-pressed="false" aria-label="{{ size_option.name }}: {{ vname | escape }}">{{ vname }}</button>
            {%- endfor -%}
          </div>
          <div class="ringani-pm__sizepanel-foot">
            <span data-ringani-size-hint data-default="{{ section.settings.size_hint_default | escape }}" data-chosen-prefix="Size">{{ section.settings.size_hint_default }}</span>
            <button type="button" class="ringani-pm__sizeguide-link" data-ringani-sizeguide-open>{{ section.settings.sizeguide_link }}</button>
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} ---------- Other options (fallback selects) ---------- {%- endcomment -%}
      {%- for opt in product.options_with_values -%}
        {%- if opt.position != color_pos and opt.position != size_pos -%}
          {%- assign opt_idx = opt.position | minus: 1 -%}
          {%- assign current_opt = current.options[opt_idx] -%}
          <div class="ringani-pm__group">
            <label class="ringani-eyebrow" for="ringani-opt-{{ section.id }}-{{ opt.position }}">{{ opt.name }}</label>
            <select id="ringani-opt-{{ section.id }}-{{ opt.position }}" class="ringani-pm__select" data-ringani-option-select data-position="{{ opt.position }}">
              {%- for value in opt.values -%}
                {%- assign vname = value.name | default: value -%}
                <option value="{{ vname | escape }}" {% if current_opt == vname %}selected{% endif %}>{{ vname }}</option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%}
        ---------- Bundle offers (quantity breaks) ----------
        Each "offer" block = one selectable card. Price shown = unit price ×
        paid units (quantity − free units); compare = compare-at (or price)
        × quantity. The free units must be honoured at checkout by a matching
        automatic discount (e.g. "Buy X get Y") in Shopify admin.
      {%- endcomment -%}
      {%- liquid
        assign offer_blocks = section.blocks | where: 'type', 'offer'
        assign offer_default = 0
        for block in offer_blocks
          if block.settings.preselect
            assign offer_default = forloop.index0
            break
          endif
        endfor
        assign unit_compare = current.price
        if has_compare
          assign unit_compare = current.compare_at_price
        endif
        assign initial_qty = 1
      -%}
      {%- if offer_blocks.size > 0 -%}
        <div class="ringani-pm__offers" role="radiogroup" aria-label="{{ section.settings.offers_heading | default: 'Bundle offers' | escape }}"
          style="--ringani-offer-accent:{{ section.settings.offer_accent }};--ringani-offer-tint:{{ section.settings.offer_tint }};--ringani-offer-badge-text:{{ section.settings.offer_badge_text }}">
          {%- if section.settings.offers_heading != blank -%}
            <div class="ringani-pm__divider-head"><span>{{ section.settings.offers_heading }}</span></div>
          {%- endif -%}
          {%- for block in offer_blocks -%}
            {%- liquid
              assign o_qty = block.settings.quantity
              assign o_free = block.settings.free_units | at_most: o_qty
              assign o_paid = o_qty | minus: o_free | at_least: 1
              assign o_price = current.price | times: o_paid
              assign o_compare = unit_compare | times: o_qty
              assign o_save = o_compare | minus: o_price | at_least: 0
              assign o_save_money = o_save | money
              assign o_selected = false
              if forloop.index0 == offer_default
                assign o_selected = true
                assign initial_qty = o_qty
              endif
            -%}
            <button type="button" role="radio" class="ringani-pm__offer" data-ringani-offer
              data-qty="{{ o_qty }}" data-paid="{{ o_paid }}"
              aria-checked="{{ o_selected }}" tabindex="{% if o_selected %}0{% else %}-1{% endif %}"
              {{ block.shopify_attributes }}>
              {%- if block.settings.badge != blank -%}
                <span class="ringani-pm__offer-badge">{{ block.settings.badge }}</span>
              {%- endif -%}
              {%- if block.settings.image != blank -%}
                <span class="ringani-pm__offer-img">
                  {{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '80, 160, 200', alt: '' }}
                </span>
              {%- endif -%}
              <span class="ringani-pm__offer-body">
                <span class="ringani-pm__offer-title">{{ block.settings.title }}</span>
                {%- if block.settings.subtitle != blank -%}
                  <span class="ringani-pm__offer-sub" data-ringani-offer-text data-template="{{ block.settings.subtitle | escape }}" {% if o_save == 0 and block.settings.subtitle contains '{amount}' %}hidden{% endif %}>{{ block.settings.subtitle | replace: '{amount}', o_save_money }}</span>
                {%- endif -%}
                {%- if block.settings.bullets != blank -%}
                  {%- assign o_lines = block.settings.bullets | newline_to_br | strip_newlines | split: '<br />' -%}
                  <span class="ringani-pm__offer-bullets">
                    {%- for line in o_lines -%}
                      {%- assign line_t = line | strip -%}
                      {%- if line_t != blank -%}
                        <span class="ringani-pm__offer-bullet" {% if o_save == 0 and line_t contains '{amount}' %}hidden{% endif %}>
                          <span class="ringani-pm__offer-check" aria-hidden="true">✓</span>
                          <span data-ringani-offer-text data-template="{{ line_t | escape }}">{{ line_t | replace: '{amount}', o_save_money }}</span>
                        </span>
                      {%- endif -%}
                    {%- endfor -%}
                  </span>
                {%- endif -%}
              </span>
              <span class="ringani-pm__offer-prices">
                <span class="ringani-pm__offer-price" data-ringani-offer-price>{{ o_price | money }}</span>
                <span class="ringani-pm__offer-compare" data-ringani-offer-compare {% if o_save == 0 %}hidden{% endif %}>{{ o_compare | money }}</span>
              </span>
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%}
        ---------- Purchase options: one-time vs. subscription ----------
        Rendered only when the product has selling plans (subscription app,
        e.g. "Shopify Subscriptions"). Prices come from the plan allocations.
      {%- endcomment -%}
      {%- if section.settings.sub_enable and product.selling_plan_groups.size > 0 -%}
        {%- liquid
          assign first_alloc = current.selling_plan_allocations | first
          assign sub_percent = 0
          if first_alloc and first_alloc.compare_at_price > 0
            assign sub_diff = first_alloc.compare_at_price | minus: first_alloc.price | times: 100
            assign sub_percent = sub_diff | divided_by: first_alloc.compare_at_price | round
          endif
          assign sub_selected = false
          if product.requires_selling_plan or section.settings.sub_default == 'sub'
            assign sub_selected = true
          endif
          assign sub_label = section.settings.sub_label | replace: '{percent}', sub_percent
          assign sub_badge = section.settings.sub_badge | replace: '{percent}', sub_percent
        -%}
        <div class="ringani-pm__plans" data-ringani-plans
          style="--ringani-offer-accent:{{ section.settings.offer_accent }};--ringani-offer-tint:{{ section.settings.offer_tint }}">
          {%- if section.settings.sub_heading != blank -%}
            <div class="ringani-pm__divider-head"><span>{{ section.settings.sub_heading }}</span></div>
          {%- endif -%}
          <div role="radiogroup" aria-label="{{ section.settings.sub_heading | default: 'Purchase options' | escape }}" class="ringani-pm__plans-list">
            {%- unless product.requires_selling_plan -%}
              <div class="ringani-pm__plan" data-ringani-plan-card data-active="{% if sub_selected %}false{% else %}true{% endif %}">
                <button type="button" role="radio" class="ringani-pm__plan-head" data-ringani-purchase="once" aria-checked="{% if sub_selected %}false{% else %}true{% endif %}">
                  <span class="ringani-pm__plan-dot" aria-hidden="true"></span>
                  <span class="ringani-pm__plan-label">{{ section.settings.once_label }}</span>
                  <span class="ringani-pm__plan-prices">
                    <span class="ringani-pm__plan-price" data-ringani-once-price>{{ current.price | money }}</span>
                  </span>
                </button>
              </div>
            {%- endunless -%}
            <div class="ringani-pm__plan" data-ringani-plan-card data-active="{{ sub_selected }}">
              <button type="button" role="radio" class="ringani-pm__plan-head" data-ringani-purchase="sub" aria-checked="{{ sub_selected }}">
                <span class="ringani-pm__plan-dot" aria-hidden="true"></span>
                <span class="ringani-pm__plan-label">
                  <span data-ringani-sub-text data-template="{{ section.settings.sub_label | escape }}">{{ sub_label }}</span>
                  {%- if section.settings.sub_badge != blank -%}
                    <span class="ringani-pm__plan-badge" data-ringani-sub-text data-template="{{ section.settings.sub_badge | escape }}" {% if sub_percent == 0 %}hidden{% endif %}>{{ sub_badge }}</span>
                  {%- endif -%}
                </span>
                <span class="ringani-pm__plan-prices">
                  <span class="ringani-pm__plan-price" data-ringani-sub-price>{% if first_alloc %}{{ first_alloc.price | money }}{% endif %}</span>
                  <span class="ringani-pm__plan-compare" data-ringani-sub-compare {% if sub_percent == 0 %}hidden{% endif %}>{% if first_alloc %}{{ first_alloc.compare_at_price | money }}{% endif %}</span>
                </span>
              </button>
              <div class="ringani-pm__plan-details">
                {%- assign how_lines = section.settings.sub_how | newline_to_br | strip_newlines | split: '<br />' -%}
                {%- if section.settings.sub_how != blank -%}
                  <div class="ringani-pm__plan-how">
                    {%- if section.settings.sub_how_heading != blank -%}<div class="ringani-pm__plan-how-title">{{ section.settings.sub_how_heading }}</div>{%- endif -%}
                    <ul>
                      {%- for line in how_lines -%}
                        {%- assign line_t = line | strip -%}
                        {%- if line_t != blank -%}
                          {%- assign line_r = line_t | replace: '{percent}', sub_percent -%}
                          {%- if first_alloc -%}{%- assign sub_price_money = first_alloc.price | money -%}{%- assign line_r = line_r | replace: '{price}', sub_price_money -%}{%- endif -%}
                          <li><span class="ringani-pm__offer-check" aria-hidden="true">✓</span><span data-ringani-sub-text data-template="{{ line_t | escape }}">{{ line_r }}</span></li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}
                {%- assign plan_count = 0 -%}
                {%- for group in product.selling_plan_groups -%}{%- assign plan_count = plan_count | plus: group.selling_plans.size -%}{%- endfor -%}
                <div class="ringani-pm__plan-freq" {% if plan_count < 2 %}hidden{% endif %}>
                  <label for="ringani-plan-{{ section.id }}">{{ section.settings.sub_frequency_label }}</label>
                  <select id="ringani-plan-{{ section.id }}" class="ringani-pm__plan-select" data-ringani-plan-select>
                    {%- for group in product.selling_plan_groups -%}
                      {%- for plan in group.selling_plans -%}
                        <option value="{{ plan.id }}" {% if first_alloc and first_alloc.selling_plan.id == plan.id %}selected{% endif %}>{{ plan.name }}</option>
                      {%- endfor -%}
                    {%- endfor -%}
                  </select>
                </div>
              </div>
            </div>
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} ---------- Quantity + Add to cart ---------- {%- endcomment -%}
      <form data-ringani-form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="ringani-pm__buy">
        <input type="hidden" name="id" value="{{ current.id }}">
        <input type="hidden" name="quantity" value="{{ initial_qty }}">
        <input type="hidden" name="selling_plan" value="" disabled data-ringani-selling-plan>
        {%- if offer_blocks.size == 0 -%}
          <div class="ringani-pm__qty">
            <button type="button" class="ringani-pm__qty-btn" data-ringani-dec aria-label="Decrease quantity">−</button>
            <span class="ringani-pm__qty-val" data-ringani-qty>1</span>
            <button type="button" class="ringani-pm__qty-btn" data-ringani-inc aria-label="Increase quantity">+</button>
          </div>
        {%- endif -%}
        <button type="submit" class="ringani-btn ringani-pm__cta" data-ringani-submit>
          <span data-ringani-cta-label>{% if size_pos > 0 %}{{ section.settings.label_choose }}{% else %}{{ section.settings.label_add }}{% endif %}</span>
        </button>
      </form>

      {%- assign trust = section.settings.trust_items | newline_to_br | strip_newlines | split: '<br />' -%}
      {%- if trust.size > 0 and section.settings.trust_items != blank -%}
        <div class="ringani-pm__trust">
          {%- for item in trust -%}
            <div class="ringani-pm__trust-item"><span class="ringani-pm__check">✓</span><span>{{ item | strip }}</span></div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} ---------- Payment bar: custom image, else badge icons ---------- {%- endcomment -%}
      {%- if section.settings.payment_image != blank -%}
        {%- assign pay_alt = section.settings.payment_image.alt | default: 'Accepted payment methods' | escape -%}
        <div class="ringani-pm__payimg" style="margin-top:18px">
          <img
            src="{{ section.settings.payment_image | image_url: width: 900 }}"
            srcset="{{ section.settings.payment_image | image_url: width: 450 }} 450w, {{ section.settings.payment_image | image_url: width: 900 }} 900w"
            sizes="(min-width: 750px) 440px, 92vw"
            alt="{{ pay_alt }}"
            loading="lazy"
            style="display:block;width:100%;max-width:{{ section.settings.payment_image_width }}px;height:auto">
        </div>
      {%- elsif section.settings.payment_icons_show -%}
        {%- assign badge_src = section.settings.payment_badges | default: '' -%}
        {%- assign badge_list = badge_src | newline_to_br | strip_newlines | split: '<br />' -%}
        {%- if badge_list.size > 0 and badge_src != '' -%}
          <div class="ringani-pm__payicons" style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:18px">
            {%- for badge_raw in badge_list -%}
              {%- assign badge = badge_raw | strip | downcase -%}
              {%- assign svg_key = '' -%}
              {%- case badge -%}
                {%- when 'paypal' -%}{%- assign svg_key = 'paypal' -%}
                {%- when 'klarna' -%}{%- assign svg_key = 'klarna' -%}
                {%- when 'visa' -%}{%- assign svg_key = 'visa' -%}
                {%- when 'mastercard' -%}{%- assign svg_key = 'master' -%}
                {%- when 'maestro' -%}{%- assign svg_key = 'maestro' -%}
                {%- when 'apple pay' -%}{%- assign svg_key = 'apple_pay' -%}
                {%- when 'google pay', 'g pay' -%}{%- assign svg_key = 'google_pay' -%}
                {%- when 'american express', 'amex' -%}{%- assign svg_key = 'american_express' -%}
              {%- endcase -%}
              {%- if svg_key != '' -%}
                <span style="display:inline-flex;align-items:center;justify-content:center;width:42px;height:27px;padding:2px;border:1px solid #E4E1DA;border-radius:5px;background:#fff">
                  {{ svg_key | payment_type_svg_tag }}
                </span>
              {%- elsif badge == 'rechnung' -%}
                <span style="display:inline-flex;align-items:center;justify-content:center;min-width:42px;height:27px;padding:2px 6px;border:1px solid #E4E1DA;border-radius:5px;background:#fff">
                  <span style="font-size:9px;font-weight:600;letter-spacing:.02em;color:#1A1A1A;white-space:nowrap">Invoice</span>
                </span>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}

      {%- assign payments = section.settings.payments | newline_to_br | strip_newlines | split: '<br />' -%}
      {%- if section.settings.payment_text_show and payments.size > 0 and section.settings.payments != blank -%}
        <div class="ringani-pm__payments">
          {%- for p in payments -%}<span class="ringani-chip">{{ p | strip }}</span>{%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} ---------- Panel accordions ---------- {%- endcomment -%}
      {%- assign panels = section.blocks | where: 'type', 'panel' -%}
      {%- if panels.size > 0 -%}
        <ringani-accordion class="ringani-pm__panels ringani-acc">
          {%- for block in panels -%}
            <div class="ringani-acc__item" {{ block.shopify_attributes }}>
              <button type="button" class="ringani-acc__head ringani-acc__head--sm" aria-expanded="false" aria-controls="ringani-panel-{{ section.id }}-{{ forloop.index }}">
                <span>{{ block.settings.title }}</span>
                <span class="ringani-acc__icon" aria-hidden="true">+</span>
              </button>
              <div class="ringani-acc__panel" id="ringani-panel-{{ section.id }}-{{ forloop.index }}" hidden>
                <div class="ringani-acc__panel-inner">{{ block.settings.body }}</div>
              </div>
            </div>
          {%- endfor -%}
        </ringani-accordion>
      {%- endif -%}
    </div>

    {%- comment -%} ================= STICKY ADD-TO-CART ================= {%- endcomment -%}
    {%- if section.settings.sticky_enable -%}
      <div class="ringani-pm__sticky" data-ringani-sticky data-visible="false" data-anchor="#ringani-produkt">
        <div class="ringani-inner ringani-pm__sticky-inner">
          <div class="ringani-pm__sticky-thumb">
            {%- if product.featured_media -%}
              {%- assign sticky_alt = product.title | escape -%}
              {{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: sticky_alt }}
            {%- endif -%}
          </div>
          <div class="ringani-pm__sticky-text">
            <div class="ringani-pm__sticky-title">{{ product.title | escape }}</div>
            <div class="ringani-pm__sticky-summary" data-ringani-sticky-summary></div>
          </div>
          <form data-ringani-form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
            <input type="hidden" name="id" value="{{ current.id }}">
            <input type="hidden" name="quantity" value="{{ initial_qty }}">
            <input type="hidden" name="selling_plan" value="" disabled data-ringani-selling-plan>
            <button type="submit" class="ringani-btn ringani-pm__sticky-cta" data-ringani-submit>
              <span data-ringani-cta-label>{% if size_pos > 0 %}{{ section.settings.label_choose }}{% else %}{{ section.settings.label_add }}{% endif %}</span>
            </button>
          </form>
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} ================= SIZE-GUIDE MODAL ================= {%- endcomment -%}
    {%- assign size_rows = section.blocks | where: 'type', 'size_row' -%}
    {%- if size_rows.size > 0 -%}
      <div class="ringani-pm__overlay" id="ringani-overlay-{{ section.id }}" data-open="false" data-ringani-overlay></div>
      <div class="ringani-pm__modal" id="ringani-sizeguide-{{ section.id }}" data-open="false" role="dialog" aria-modal="true" aria-label="{{ section.settings.sizeguide_heading | escape }}">
        <div class="ringani-pm__modal-head">
          <h3>{{ section.settings.sizeguide_heading }}</h3>
          <button type="button" class="ringani-pm__modal-close" data-ringani-sizeguide-close aria-label="Close">×</button>
        </div>
        {%- if section.settings.sizeguide_intro != blank -%}<p class="ringani-pm__modal-intro">{{ section.settings.sizeguide_intro }}</p>{%- endif -%}
        <div class="ringani-pm__sizetable">
          <div class="ringani-pm__sizetable-head">
            <span>{{ section.settings.sizeguide_col1 }}</span>
            <span>{{ section.settings.sizeguide_col2 }}</span>
            <span>{{ section.settings.sizeguide_col3 }}</span>
          </div>
          {%- for block in size_rows -%}
            <div class="ringani-pm__sizetable-row" {{ block.shopify_attributes }}>
              <span>{{ block.settings.size }}</span>
              <span>{{ block.settings.diameter }}</span>
              <span>{{ block.settings.circumference }}</span>
            </div>
          {%- endfor -%}
        </div>
        {%- if section.settings.sizeguide_note != blank -%}<p class="ringani-pm__modal-note">{{ section.settings.sizeguide_note }}</p>{%- endif -%}
      </div>
    {%- endif -%}
  </ringani-product>
</section>


{% schema %}
{
  "name": "RINGANI – Product",
  "tag": "section",
  "class": "ringani-section-wrapper",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "checkbox", "id": "rating_show", "label": "Show rating line", "default": true },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.8/5 based on customer reviews" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Your health. Right on your finger." },
    { "type": "text", "id": "tax_note", "label": "Price note", "default": "Free shipping included" },
    { "type": "header", "content": "Price & Savings" },
    { "type": "checkbox", "id": "show_savings", "label": "Show savings badge (when compare price is set)", "default": true },
    { "type": "text", "id": "save_template", "label": "Savings text", "info": "{amount} is replaced with the calculated amount.", "default": "You save {amount}" },
    { "type": "header", "content": "Variant Mapping" },
    { "type": "paragraph", "content": "These names must match the product options exactly for color swatches and size buttons to be generated." },
    { "type": "text", "id": "color_option_name", "label": "Color option name", "default": "Color" },
    { "type": "text", "id": "size_option_name", "label": "Size option name", "default": "Size" },
    { "type": "header", "content": "Size Panel" },
    { "type": "text", "id": "size_panel_heading", "label": "Heading", "default": "I know my size" },
    { "type": "text", "id": "size_panel_sub", "label": "Subtitle", "default": "Choose your ring size" },
    { "type": "text", "id": "size_hint_default", "label": "Default hint", "default": "Grayed-out sizes are currently sold out." },
    { "type": "text", "id": "sizeguide_link", "label": "Size guide link", "default": "What size do I need?" },
    { "type": "header", "content": "Bundle Offers" },
    { "type": "paragraph", "content": "Add \"Bundle offer\" blocks to show quantity cards (e.g. Buy 1 / Buy 2 Get 1 FREE). Free units must also be set up as an automatic discount (Buy X get Y) in Shopify admin → Discounts, otherwise checkout charges full price." },
    { "type": "text", "id": "offers_heading", "label": "Heading above offers", "default": "Bundle & Save" },
    { "type": "color", "id": "offer_accent", "label": "Accent color (selected card, badge)", "default": "#1B6FD4" },
    { "type": "color", "id": "offer_tint", "label": "Selected card background", "default": "#F1F7FF" },
    { "type": "color", "id": "offer_badge_text", "label": "Badge text color", "default": "#FFFFFF" },
    { "type": "header", "content": "Subscription (Subscribe & Save)" },
    { "type": "paragraph", "content": "Shown only when the product has a subscription plan (e.g. via the free \"Shopify Subscriptions\" app). Discount and delivery intervals come from that plan." },
    { "type": "checkbox", "id": "sub_enable", "label": "Show purchase options", "default": true },
    { "type": "select", "id": "sub_default", "label": "Preselected option", "options": [
      { "value": "once", "label": "One-time purchase" },
      { "value": "sub", "label": "Subscribe & Save" }
    ], "default": "once" },
    { "type": "text", "id": "sub_heading", "label": "Heading", "default": "Choose your purchase option" },
    { "type": "text", "id": "once_label", "label": "One-time label", "default": "One-time purchase" },
    { "type": "text", "id": "sub_label", "label": "Subscription label", "info": "{percent} = subscription discount.", "default": "Subscribe & Save {percent}%" },
    { "type": "text", "id": "sub_badge", "label": "Subscription badge", "default": "{percent}% off" },
    { "type": "text", "id": "sub_how_heading", "label": "Details heading", "default": "How it works:" },
    { "type": "textarea", "id": "sub_how", "label": "Details (one per line)", "info": "{percent} = discount, {price} = subscription price per unit.", "default": "Save {percent}% on every delivery.\n{price} per unit, charged automatically with each delivery until you cancel.\nShipping and any applicable taxes are shown at checkout.\nSkip, pause or cancel anytime" },
    { "type": "text", "id": "sub_frequency_label", "label": "Frequency label", "default": "Deliver every:" },
    { "type": "header", "content": "Add-to-Cart Labels" },
    { "type": "text", "id": "label_add", "label": "Available", "default": "Add to Cart" },
    { "type": "text", "id": "label_soldout", "label": "Sold Out", "default": "Sold Out" },
    { "type": "text", "id": "label_choose", "label": "No size selected", "default": "Select Size" },
    { "type": "select", "id": "on_add", "label": "After adding", "options": [
      { "value": "drawer", "label": "Open cart drawer (if available)" },
      { "value": "cart", "label": "Go to cart page" },
      { "value": "stay", "label": "Stay on page (notification only)" }
    ], "default": "drawer" },
    { "type": "header", "content": "Trust & Payment" },
    { "type": "textarea", "id": "trust_items", "label": "Trust points (one per line)", "default": "Free Shipping\nSecure Payment\n30-Day Returns" },
    { "type": "image_picker", "id": "payment_image", "label": "Payment image (logo bar)", "info": "Upload your own payment method graphic (e.g. PayPal, Visa …). Displayed instead of the auto-generated icons." },
    { "type": "range", "id": "payment_image_width", "min": 160, "max": 600, "step": 10, "unit": "px", "label": "Max width payment image", "default": 440 },
    { "type": "checkbox", "id": "payment_icons_show", "label": "Show payment badges", "info": "Displays the badges from the list below as styled icons (fallback when no payment image is set).", "default": true },
    { "type": "textarea", "id": "payment_badges", "label": "Payment badges (one per line)", "info": "Order and selection of badge icons. Supported: PayPal, Klarna, Visa, Mastercard, Maestro, Apple Pay, Google Pay, G Pay, American Express, AMEX", "default": "PayPal\nVisa\nMastercard\nApple Pay\nGoogle Pay\nAmerican Express" },
    { "type": "checkbox", "id": "payment_text_show", "label": "Show payment methods as text chips", "default": false },
    { "type": "textarea", "id": "payments", "label": "Payment methods as text (one per line)", "info": "Only relevant when text chips above are enabled.", "default": "Visa\nMastercard\nPayPal\nApple Pay\nGoogle Pay" },
    { "type": "header", "content": "Sticky Add-to-Cart" },
    { "type": "checkbox", "id": "sticky_enable", "label": "Enable sticky buy bar", "default": true },
    { "type": "header", "content": "Size Guide (Modal)" },
    { "type": "text", "id": "sizeguide_heading", "label": "Heading", "default": "Find Your Ring Size" },
    { "type": "textarea", "id": "sizeguide_intro", "label": "Introduction", "default": "Measure the inner diameter of a well-fitting ring or the finger circumference with a measuring tape. Measure in the evening – fingers are thinner in the morning." },
    { "type": "text", "id": "sizeguide_col1", "label": "Column 1", "default": "Size" },
    { "type": "text", "id": "sizeguide_col2", "label": "Column 2", "default": "Inner Diameter" },
    { "type": "text", "id": "sizeguide_col3", "label": "Column 3", "default": "Circumference" },
    { "type": "textarea", "id": "sizeguide_note", "label": "Note below", "default": "Not sure? A free sizing kit can be added during checkout." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 2, "unit": "px", "label": "Top (Desktop)", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "label": "Bottom (Desktop)", "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Top (Mobile)", "default": 20 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 120, "step": 2, "unit": "px", "label": "Bottom (Mobile)", "default": 56 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Describe benefit" }
      ]
    },
    {
      "type": "panel",
      "name": "Info Panel (Accordion)",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Shipping & Delivery" },
        { "type": "richtext", "id": "body", "label": "Text", "default": "<p>Enter description here.</p>" }
      ]
    },
    {
      "type": "offer",
      "name": "Bundle offer",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Buy 1" },
        { "type": "range", "id": "quantity", "min": 1, "max": 10, "step": 1, "label": "Units added to cart", "default": 1 },
        { "type": "range", "id": "free_units", "min": 0, "max": 5, "step": 1, "label": "Of which free", "info": "E.g. Buy 2 Get 1 FREE: units 3, free 1. Requires a matching automatic discount in Shopify admin.", "default": 0 },
        { "type": "text", "id": "badge", "label": "Badge", "info": "E.g. Most Popular. Leave empty for none." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "info": "{amount} = calculated savings.", "default": "You save {amount}" },
        { "type": "textarea", "id": "bullets", "label": "Check points (one per line)", "info": "{amount} = calculated savings." },
        { "type": "checkbox", "id": "preselect", "label": "Preselected", "default": false }
      ]
    },
    {
      "type": "size_row",
      "name": "Size Chart: Row",
      "settings": [
        { "type": "text", "id": "size", "label": "Size", "default": "Size 7" },
        { "type": "text", "id": "diameter", "label": "Inner Diameter", "default": "17.3 mm" },
        { "type": "text", "id": "circumference", "label": "Circumference", "default": "54.3 mm" }
      ]
    }
  ],
  "presets": [
    {
      "name": "RINGANI – Product (Main)",
      "blocks": [
        { "type": "benefit", "settings": { "text": "Understand sleep & recovery night after night" } },
        { "type": "benefit", "settings": { "text": "Track heart rate and trends at a glance" } },
        { "type": "benefit", "settings": { "text": "Automatically track activity and steps" } },
        { "type": "benefit", "settings": { "text": "Long battery life" } },
        { "type": "benefit", "settings": { "text": "No monthly fees – no subscription" } },
        { "type": "panel", "settings": { "title": "Shipping & Delivery", "body": "<p>Free shipping within the US. Delivery typically within 3–5 business days. Tracking via email.</p>" } },
        { "type": "panel", "settings": { "title": "Returns & Warranty", "body": "<p>30-day return policy from date of receipt. 2-year manufacturer warranty.</p>" } },
        { "type": "panel", "settings": { "title": "Compatibility", "body": "<p>The RINGANI app is available for iOS and Android.</p>" } },
        { "type": "size_row", "settings": { "size": "Size 6", "diameter": "16.5 mm", "circumference": "51.8 mm" } },
        { "type": "size_row", "settings": { "size": "Size 7", "diameter": "17.3 mm", "circumference": "54.3 mm" } },
        { "type": "size_row", "settings": { "size": "Size 8", "diameter": "18.1 mm", "circumference": "56.9 mm" } },
        { "type": "size_row", "settings": { "size": "Size 9", "diameter": "18.9 mm", "circumference": "59.4 mm" } },
        { "type": "size_row", "settings": { "size": "Size 10", "diameter": "19.8 mm", "circumference": "62.2 mm" } },
        { "type": "size_row", "settings": { "size": "Size 11", "diameter": "20.6 mm", "circumference": "64.7 mm" } },
        { "type": "size_row", "settings": { "size": "Size 12", "diameter": "21.4 mm", "circumference": "67.2 mm" } },
        { "type": "size_row", "settings": { "size": "Size 13", "diameter": "22.2 mm", "circumference": "69.7 mm" } }
      ]
    }
  ]
}
{% endschema %}
