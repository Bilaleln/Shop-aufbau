{%- comment -%}
  RINGANI – FAQ
  Accordion of question/answer blocks. Optional FAQ schema.org JSON-LD.
{%- endcomment -%}
<section id="{{ section.settings.anchor | default: 'faq' }}" class="ringani ringani-section ringani-faq" style="{% render 'ringani-section-vars', s: section %}">
  <div class="ringani-inner ringani-inner--narrow">
    {%- if section.settings.heading != blank -%}
      <h2 class="ringani-h2 ringani-reveal">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <ringani-accordion class="ringani-acc ringani-reveal ringani-faq__acc">
      {%- for block in section.blocks -%}
        <div class="ringani-acc__item" {{ block.shopify_attributes }}>
          <button type="button" class="ringani-acc__head" aria-expanded="false" aria-controls="ringani-faq-{{ section.id }}-{{ block.id }}">
            <span>{{ block.settings.question }}</span>
            <span class="ringani-acc__icon" aria-hidden="true">+</span>
          </button>
          <div class="ringani-acc__panel" id="ringani-faq-{{ section.id }}-{{ block.id }}" hidden>
            <div class="ringani-acc__panel-inner">{{ block.settings.answer }}</div>
          </div>
        </div>
      {%- endfor -%}
    </ringani-accordion>
  </div>
</section>

{%- if section.settings.enable_schema and section.blocks.size > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
      {
        "@type": "Question",
        "name": {{ block.settings.question | strip_html | json }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

{% stylesheet %}
.ringani-faq{background:linear-gradient(180deg,#EDF3FB 0%,#F6F9FD 100%)}
.ringani-faq__acc{display:block;margin-top:clamp(32px,4vw,56px);border-top:1px solid #DEDBD4}
@media (max-width:749px){
  .ringani-faq .ringani-h2{font-size:clamp(24px,6.5vw,32px)}
  .ringani-faq .ringani-acc__head{min-height:44px;padding:14px 0}
}
{% endstylesheet %}

{% schema %}
{
  "name": "RINGANI – FAQ",
  "tag": "section",
  "max_blocks": 20,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "faq" },
    { "type": "checkbox", "id": "enable_schema", "label": "Output FAQ rich snippet (SEO)", "default": true },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Top (Desktop)", "default": 120 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Bottom (Desktop)", "default": 120 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top (Mobile)", "default": 72 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom (Mobile)", "default": 72 }
  ],
  "blocks": [
    { "type": "faq", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "What does the RINGANI Smart Ring measure?" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>The ring captures the metrics listed in the technical specifications, including sleep data, heart rate, and activity. The full list can be found in the 'Specifications' section. RINGANI is a wellness product and not a medical device.</p>" }
    ] }
  ],
  "presets": [
    { "name": "RINGANI – FAQ", "blocks": [
      { "type": "faq", "settings": { "question": "What does the RINGANI Smart Ring measure?", "answer": "<p>The ring captures the metrics listed in the technical specifications, including sleep data, heart rate, and activity. The full list can be found in the 'Specifications' section. RINGANI is a wellness product and not a medical device.</p>" } },
      { "type": "faq", "settings": { "question": "How do I find the right ring size?", "answer": "<p>Use the size calculator via 'What size do I need?' or measure the inner diameter of a well-fitting ring. If unsure, you can add a free sizing kit during checkout.</p>" } },
      { "type": "faq", "settings": { "question": "Can I wear RINGANI while sleeping?", "answer": "<p>Yes. The ring is flat, lightweight, and designed without a display – made to be worn day and night.</p>" } },
      { "type": "faq", "settings": { "question": "How long does the battery last?", "answer": "<p>Up to 7 days depending on usage. The charging case provides additional charges on the go.</p>" } },
      { "type": "faq", "settings": { "question": "Does RINGANI work with iPhone and Android?", "answer": "<p>The RINGANI app is available for iOS and Android. Minimum supported versions can be found in the specifications.</p>" } },
      { "type": "faq", "settings": { "question": "Do I need a subscription?", "answer": "<p>No. All app features are included without monthly fees.</p>" } },
      { "type": "faq", "settings": { "question": "Is the ring waterproof?", "answer": "<p>The protection rating is 10 ATM. The ring is not intended for diving.</p>" } },
      { "type": "faq", "settings": { "question": "How do returns work?", "answer": "<p>You have a 30-day return window from receipt. Contact support to receive a return label, and after inspection, you'll receive your refund.</p>" } }
    ] }
  ]
}
{% endschema %}
