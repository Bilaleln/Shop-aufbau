{%- comment -%}
  RINGANI – Specifications
  Accordion of spec groups. Two block types:
    group  → starts a new accordion item (heading)
    row    → a key/value line added under the current group
  Reorder / add / remove freely in the Theme Editor.
{%- endcomment -%}
<section id="{{ section.settings.anchor | default: 'specs' }}" class="ringani ringani-section ringani-spec" style="{% render 'ringani-section-vars', s: section %}">
  <div class="ringani-inner ringani-inner--narrow">
    {%- if section.settings.heading != blank -%}
      <h2 class="ringani-h2 ringani-reveal">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <ringani-accordion class="ringani-acc ringani-reveal ringani-spec__acc">
      {%- assign open = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'group' -%}
          {%- if open -%}</div></div></div></div>{%- endif -%}
          <div class="ringani-acc__item" {{ block.shopify_attributes }}>
            <button type="button" class="ringani-acc__head" aria-expanded="false" aria-controls="ringani-spec-{{ section.id }}-{{ block.id }}">
              <span>{{ block.settings.title }}</span>
              <span class="ringani-acc__icon" aria-hidden="true">+</span>
            </button>
            <div class="ringani-acc__panel" id="ringani-spec-{{ section.id }}-{{ block.id }}" hidden><div class="ringani-acc__panel-inner"><div class="ringani-spec__rows">
          {%- assign open = true -%}
        {%- elsif block.type == 'row' and open -%}
          <div class="ringani-spec__row" {{ block.shopify_attributes }}>
            <span class="ringani-spec__k">{{ block.settings.key }}</span>
            <span class="ringani-spec__v">{{ block.settings.value }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
      {%- if open -%}</div></div></div></div>{%- endif -%}
    </ringani-accordion>
  </div>
</section>

{% stylesheet %}
.ringani-spec__acc{display:block;margin-top:clamp(32px,4vw,56px);border-top:1px solid #DEDBD4}
.ringani-spec__rows{display:grid;gap:10px}
.ringani-spec__row{display:flex;justify-content:space-between;gap:24px;font-size:14.5px;line-height:1.5}
.ringani-spec__k{color:#6E6B64}
.ringani-spec__v{color:#0E0E0E;text-align:right}
@media (max-width:749px){
  .ringani-spec .ringani-acc__head{min-height:44px;padding:14px 0}
  .ringani-spec__row{gap:12px;font-size:13.5px}
  .ringani-spec__v{min-width:0;word-break:break-word}
}
{% endstylesheet %}

{% schema %}
{
  "name": "RINGANI – Specifications",
  "tag": "section",
  "max_blocks": 50,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Specifications" },
    { "type": "text", "id": "anchor", "label": "Anchor ID (for navigation)", "default": "specs" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Top (Desktop)", "default": 120 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Bottom (Desktop)", "default": 120 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top (Mobile)", "default": 72 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom (Mobile)", "default": 72 }
  ],
  "blocks": [
    { "type": "group", "name": "Group (Heading)", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Design & Material" }
    ] },
    { "type": "row", "name": "Row (Feature/Value)", "settings": [
      { "type": "text", "id": "key", "label": "Feature", "default": "Material" },
      { "type": "text", "id": "value", "label": "Value", "default": "Titanium" }
    ] }
  ],
  "presets": [
    { "name": "RINGANI – Specifications", "blocks": [
      { "type": "group", "settings": { "title": "Design & Material" } },
      { "type": "row", "settings": { "key": "Material", "value": "Titanium" } },
      { "type": "row", "settings": { "key": "Weight", "value": "3 g" } },
      { "type": "row", "settings": { "key": "Thickness", "value": "2.6 mm" } },
      { "type": "row", "settings": { "key": "Width", "value": "7.8 mm" } },
      { "type": "group", "settings": { "title": "Battery & Charging" } },
      { "type": "row", "settings": { "key": "Battery life", "value": "up to 7 days" } },
      { "type": "row", "settings": { "key": "Charge time", "value": "90 min" } },
      { "type": "row", "settings": { "key": "Charges in case", "value": "5" } },
      { "type": "group", "settings": { "title": "Sensors & Metrics" } },
      { "type": "row", "settings": { "key": "Sensors", "value": "Heart rate, temperature, motion" } },
      { "type": "row", "settings": { "key": "Metrics", "value": "Sleep, resting heart rate, activity" } },
      { "type": "group", "settings": { "title": "Water Resistance" } },
      { "type": "row", "settings": { "key": "Protection rating", "value": "10 ATM" } },
      { "type": "row", "settings": { "key": "Note", "value": "Not suitable for diving" } },
      { "type": "group", "settings": { "title": "Connectivity & App" } },
      { "type": "row", "settings": { "key": "Bluetooth", "value": "5.0" } },
      { "type": "row", "settings": { "key": "iOS", "value": "iOS 14+" } },
      { "type": "row", "settings": { "key": "Android", "value": "Android 8+" } },
      { "type": "group", "settings": { "title": "What's Included" } },
      { "type": "row", "settings": { "key": "Included", "value": "Ring, charging case, USB-C cable, quick start guide" } },
      { "type": "row", "settings": { "key": "Warranty", "value": "2 years" } }
    ] }
  ]
}
{% endschema %}
