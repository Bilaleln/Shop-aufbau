{%- comment -%}
  RINGANI – Statement
  Centered eyebrow + heading + lead, with an optional wide media below.
  Reused for the dark "Health begins with understanding" hero and the light
  "No Subscription" statement.
{%- endcomment -%}
{%- liquid
  assign theme_dark = false
  if section.settings.color_scheme == 'dark'
    assign theme_dark = true
  endif
-%}
<section class="ringani ringani-section ringani-statement{% if theme_dark %} ringani-on-dark ringani-statement--dark{% endif %}"
  style="{% render 'ringani-section-vars', s: section %}">
  <div class="ringani-inner ringani-inner--prose ringani-statement__inner">
    {%- if section.settings.eyebrow != blank -%}
      <div class="ringani-eyebrow ringani-reveal">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="ringani-statement__h ringani-reveal">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <p class="ringani-lead ringani-statement__body ringani-reveal">{{ section.settings.body }}</p>
    {%- endif -%}
  </div>
  {%- if section.settings.show_media -%}
    <div class="ringani-inner ringani-statement__media-wrap ringani-reveal">
      <div class="ringani-media{% if theme_dark %} ringani-media--dark{% endif %} ringani-statement__media" style="aspect-ratio:{{ section.settings.media_ratio }}">
        {%- render 'ringani-image', image: section.settings.image, image_mobile: section.settings.image_mobile, alt: section.settings.heading, sizes: '(min-width: 820px) 820px, 100vw', placeholder: 'hero-apparel' -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
.ringani-statement--dark{background:linear-gradient(180deg,#071B33 0%,#0C2E56 52%,#050F1C 100%)}
.ringani-statement__inner{text-align:center}
.ringani-statement__h{font-size:clamp(32px,5.4vw,64px);line-height:1.03;letter-spacing:-.035em;font-weight:400;margin-top:22px}
.ringani-statement--dark .ringani-statement__h{font-weight:400}
.ringani-statement__body{margin:22px auto 0;max-width:56ch}
.ringani-statement__media-wrap{margin-top:clamp(44px,6vw,80px)}
.ringani-statement__media{width:100%;border-radius:8px}
@media (max-width:749px){
  .ringani-statement__h{font-size:clamp(28px,7.5vw,38px)}
}
{% endstylesheet %}

{% schema %}
{
  "name": "RINGANI – Statement",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "RINGANI Smart Ring" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Health begins with understanding." },
    { "type": "textarea", "id": "body", "label": "Text", "default": "RINGANI accompanies you day and night and makes your body's signals understandable – right on your smartphone." },
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "options": [ { "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" } ], "default": "dark" },
    { "type": "header", "content": "Media (optional)" },
    { "type": "checkbox", "id": "show_media", "label": "Show image", "default": true },
    { "type": "image_picker", "id": "image", "label": "Image (Desktop)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image (Mobile, optional)" },
    { "type": "select", "id": "media_ratio", "label": "Aspect ratio", "options": [ { "value": "16/9", "label": "16:9" }, { "value": "3/2", "label": "3:2" }, { "value": "4/3", "label": "4:3" }, { "value": "1/1", "label": "1:1" } ], "default": "16/9" },
    { "type": "header", "content": "Colors (optional)" },
    { "type": "color", "id": "bg_color", "label": "Background" },
    { "type": "color", "id": "text_color", "label": "Text" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Top (Desktop)", "default": 120 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Bottom (Desktop)", "default": 120 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top (Mobile)", "default": 72 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom (Mobile)", "default": 72 }
  ],
  "presets": [
    { "name": "RINGANI – Statement (Hero, dark)", "settings": { "color_scheme": "dark", "show_media": true } },
    { "name": "RINGANI – Statement (Text, light)", "settings": { "eyebrow": "No Subscription", "heading": "Your data. No monthly fees.", "body": "Buy once. Use forever. All RINGANI App features are included without a subscription.", "color_scheme": "light", "show_media": false, "padding_top": 120, "padding_bottom": 120 } }
  ]
}
{% endschema %}
