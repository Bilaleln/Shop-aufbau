    "faq": {
      "type": "section-accordions",
      "blocks": {
        "q1": {
          "type": "text",
          "settings": {
            "title": "Will it burn my skin?",
            "text": "<p>It melts at a low temperature into warm oil, not hot wax. Always test the warmth with your finger first.</p>"
          }
        },
        "q2": {
          "type": "text",
          "settings": {
            "title": "Is it greasy?",
            "text": "<p>It soaks in and leaves skin soft, not sticky. Pour onto damp skin and use a small amount.</p>"
          }
        },
        "q3": {
          "type": "text",
          "settings": {
            "title": "Will it stain my sheets?",
            "text": "<p>Use a small amount and let it absorb before you get dressed or go to bed.</p>"
          }
        },
        "q4": {
          "type": "text",
          "settings": {
            "title": "How long does one candle last?",
            "text": "<p>About 60 hours of burn time, roughly 40 evenings.</p>"
          }
        },
        "q5": {
          "type": "text",
          "settings": {
            "title": "Is there an unscented option?",
            "text": "<p>Not yet. Our gentlest scents are Melon & Pear and Wild Rose.</p>"
          }
        },
        "q6": {
          "type": "text",
          "settings": {
            "title": "Can it arrive melted?",
            "text": "<p>Every jar is sealed with a lid and packed in its own box. If it ever arrives damaged, contact us and we'll send a replacement.</p>"
          }
        },
        "q7": {
          "type": "text",
          "settings": {
            "title": "What if I don't like it?",
            "text": "<p>Try it for 30 days. If you don't love it, contact us and we'll refund your purchase.</p>"
          }
        },
        "q8": {
          "type": "text",
          "settings": {
            "title": "How fast is shipping?",
            "text": "<p>Orders ship in 6–12 days with tracking.</p>"
          }
        }
