{%- comment -%}
  Renders an image_picker image with an optional mobile variant and a graceful
  placeholder fallback. Fills its (sized) container via object-fit: cover.
  Params:
    image        {image}  desktop image (from image_picker)
    image_mobile {image}  optional; falls back to `image` when empty
    alt          {string} alt text (falls back to image.alt)
    sizes        {string} responsive sizes attribute
    loading      {bool}   true => eager (above the fold), else lazy
    placeholder  {string} placeholder_svg name (default 'image')
    class        {string} extra class
{%- endcomment -%}
{%- liquid
  assign r_loading = 'lazy'
  assign r_fetch = 'auto'
  if loading
    assign r_loading = 'eager'
    assign r_fetch = 'high'
  endif
  assign r_sizes = sizes | default: '100vw'
  assign r_alt = alt | default: image.alt | default: '' | escape
  assign ph = placeholder | default: 'image'
-%}
{%- if image != blank -%}
  {%- if image_mobile != blank -%}
    <picture>
      <source media="(max-width: 749px)" srcset="{{ image_mobile | image_url: width: 800 }} 800w, {{ image_mobile | image_url: width: 1200 }} 1200w" sizes="{{ r_sizes }}">
      {{ image | image_url: width: 1600 | image_tag:
          loading: r_loading, fetchpriority: r_fetch, sizes: r_sizes,
          widths: '480, 720, 960, 1200, 1600, 2000', class: class, alt: r_alt }}
    </picture>
  {%- else -%}
    {{ image | image_url: width: 1600 | image_tag:
        loading: r_loading, fetchpriority: r_fetch, sizes: r_sizes,
        widths: '480, 720, 960, 1200, 1600, 2000', class: class, alt: r_alt }}
  {%- endif -%}
{%- else -%}
  <div class="ringani-media__placeholder">{{ ph | placeholder_svg_tag }}</div>
{%- endif -%}
