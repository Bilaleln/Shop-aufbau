{
  "sections": {
    "main": {
      "type": "main-page",
      "disabled": true,
      "settings": {
        "show_page_title": false,
        "padding_top": 60,
        "padding_bottom": 60
      }
    },
    "intro": {
      "type": "section-text",
      "blocks": {
        "sub": {
          "type": "subheading",
          "settings": {
            "text": "<p>Contact us</p>"
          }
        },
        "heading": {
          "type": "heading",
          "settings": {
            "text": "<p>How can we help you?</p>",
            "size": 150,
            "heading_highlight_type": "italics"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Questions about your order or your FADILAL Ritual Candle? Send us a message using the form below. We usually reply within [ANTWORTZEIT].</p>",
            "size": 100
          }
        }
      },
      "block_order": [
        "sub",
        "heading",
        "text"
      ],
      "settings": {
        "text_position": "center",
        "color_scheme": "scheme-1",
        "width": "wrapper--narrow",
        "padding_top": 60,
        "padding_bottom": 40
      }
    },
    "contact_icons": {
      "type": "section-icons-row",
      "blocks": {
        "orders": {
          "type": "text",
          "settings": {
            "icon_name": "package",
            "title": "Order status",
            "text": "<p>[SUPPORT E-MAIL]</p>"
          }
        },
        "returns": {
          "type": "text",
          "settings": {
            "icon_name": "mail",
            "title": "Returns and refunds",
            "text": "<p>[SUPPORT E-MAIL]</p>"
          }
        },
        "product": {
          "type": "text",
          "settings": {
            "icon_name": "support",
            "title": "Product questions",
            "text": "<p>[SUPPORT E-MAIL]</p>"
          }
        }
      },
      "block_order": [
        "orders",
        "returns",
        "product"
      ],
      "settings": {
        "alignment": "center",
        "columns": 3,
        "icons_width": 30,
        "color_scheme": "scheme-2",
        "color_border": "#d9cbb9",
        "layout_mobile": "stacked",
        "padding_top": 20,
        "padding_bottom": 20
      }
    },
    "contact-form": {
      "type": "section-contact-form",
      "blocks": {
        "contact-form-1": {
          "type": "text",
          "settings": {
            "title": "What's your name?",
            "required": true
          }
        },
        "contact-form-2": {
          "type": "email",
          "settings": {
            "title": "What's your email?",
            "required": true
          }
        },
        "contact-form-3": {
          "type": "body",
          "settings": {
            "title": "Message",
            "required": true
          }
        }
      },
      "block_order": [
        "contact-form-1",
        "contact-form-2",
        "contact-form-3"
      ],
      "settings": {
        "button_color": "btn--primary",
        "button_style": "btn--solid",
        "button_size": "btn--large",
        "width": "wrapper--narrow",
        "padding_top": 40,
        "padding_bottom": 60
      }
    }
  },
  "order": [
    "main",
    "intro",
    "contact_icons",
    "contact-form"
  ]
}
